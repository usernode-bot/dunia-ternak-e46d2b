{
  "description": "Panduan ternak untuk peternak kecil",
  "category": "other",
  "icon": {
    "emoji": "🐄"
  },
  "secrets": [],
  "governance": {
    "preset": "you_or_the_group"
  },
  "llm": {
    "purpose": "Menjawab pertanyaan peternakan dalam bahasa Indonesia"
  },
  "tests": [
    {
      "name": "FAQ",
      "path": "/",
      "expectText": "Berapa lama sapi bunting?"
    },
    {
      "id": "faq-tools",
      "name": "FAQ quick tools and cards",
      "path": "/#faq",
      "expectSelector": "#tools [data-tool=\"lahiran\"]",
      "expectText": "Alat cepat",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**"
      ]
    },
    {
      "id": "forum-demo",
      "name": "Forum demo",
      "path": "/?demo=1#forum",
      "expectSelector": "[data-post]",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "id": "forum-filter",
      "name": "Forum animal filter",
      "path": "/?demo=1#forum",
      "expectSelector": "#forum-chips [data-cat=\"sapi\"]"
    },
    {
      "name": "AI warning",
      "path": "/#ai",
      "expectText": "Jawaban AI bersifat umum dan bisa keliru."
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
